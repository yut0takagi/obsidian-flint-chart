{
  "name": "obsidian-flint-chart",
  "version": "0.2.0",
  "description": "Render Microsoft Flint semantic chart specifications inside Markdown notes.",
  "license": "MIT",
  "author": "Yuto Takagi",
  "repository": {
    "type": "git",
    "url": "https://github.com/yut0takagi/obsidian-flint-chart.git"
  },
  "homepage": "https://github.com/yut0takagi/obsidian-flint-chart#readme",
  "bugs": "https://github.com/yut0takagi/obsidian-flint-chart/issues",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "chart",
    "dataviz",
    "flint",
    "echarts"
  ],
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && node scripts/check-plugin.mjs && npm run build",
    "check:plugin": "node scripts/check-plugin.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "flint-chart": "0.5.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.3.0",
    "vitest": "^5.0.4"
  }
}
